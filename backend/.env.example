# ============================================================
# Agent Forge - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ============================================================

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.0-flash                      # Primary reasoning model
GEMINI_EMBEDDING_MODEL=models/text-embedding-004       # Multilingual embedding model

# --- Cohere API (Reranker) ---
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-multilingual-v3.0           # Multilingual reranker

# --- Qdrant Cloud (Vector Database) ---
QDRANT_URL=https://your-cluster.qdrant.io              # Your Qdrant Cloud URL
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=indian_family_law                    # Collection name

# --- Government Legal Knowledge Base API (Optional) ---
GOVT_LEGAL_API_KEY=
GOVT_LEGAL_API_BASE_URL=https://api.indiacode.nic.in/api

# --- Application Settings ---
APP_ENV=development                                    # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# --- LangGraph Checkpointing ---
LANGGRAPH_CHECKPOINT_BACKEND=memory

# --- Retrieval Settings ---
QDRANT_TOP_K=20                                        # Candidates fetched from Qdrant
COHERE_RERANK_TOP_N=5                                  # Top results after reranking
VERIFICATION_MAX_RETRIES=2                             # Max Verification->Retrieval retries

# --- Safety Settings ---
EMERGENCY_HELPLINE_NCW=7827170170
EMERGENCY_HELPLINE_GENERAL=112
DLSA_HELPLINE=15100                                    # National Legal Services Authority

# --- TTS Settings (Edge-TTS Neural Voices) ---
TTS_VOICE_ENGLISH=en-IN-NeerjaNeural
TTS_VOICE_HINDI=hi-IN-SwaraNeural
TTS_VOICE_KANNADA=kn-IN-GaganNeural
TTS_VOICE_TELUGU=te-IN-ShrutiNeural
TTS_VOICE_TAMIL=ta-IN-PallaviNeural
TTS_VOICE_BENGALI=bn-IN-TanishaaNeural
TTS_VOICE_MARATHI=mr-IN-AarohiNeural
TTS_VOICE_GUJARATI=gu-IN-DhwaniNeural
TTS_VOICE_MALAYALAM=ml-IN-SobhanaNeural
TTS_VOICE_URDU=ur-IN-GulNeural

# --- CORS Settings (Frontend URLs) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
